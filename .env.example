# Telegram
BOT_TOKEN=123456:ABC...
CHANNEL_URL=https://t.me/your_channel
# Для проверки подписки бот должен быть админом канала
CHANNEL_ID=@your_channel
# true — AI-менеджер отвечает только подписчикам канала
REQUIRE_SUBSCRIPTION=false
# Telegram ID админов (узнать свой ID: @userinfobot)
ADMIN_IDS=[123456789]
# Часовой пояс для отложенных рассылок (например Europe/Moscow, Asia/Almaty)
TIMEZONE=UTC

# PostgreSQL
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=crm
DATABASE_URL=postgresql+asyncpg://crm:crm@db:5432/crm

# Claude API (AI-менеджер)
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-opus-5-5

# Доступ к CRM API (заголовок X-API-Key)
ADMIN_API_KEY=change-me

# Только для сервера: домен админки, например crm.example.com. Пусто — без HTTPS (вход через SSH-туннель)
DOMAIN=

# Веб-админка http://localhost:8000/admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SECRET_KEY=change-me
