# Telegram
BOT_TOKEN=123456:ABC...
CHANNEL_URL=https://t.me/your_channel
# Для проверки подписки бот должен быть админом канала
CHANNEL_ID=@your_channel
# true — AI-менеджер отвечает только подписчикам канала
REQUIRE_SUBSCRIPTION=false
# Посты в канал: бот должен быть админом канала с правом «Публикация сообщений».
# true — посты, которые AI пишет сам (новый товар, промокод), выходят без подтверждения
CHANNEL_AUTOPUBLISH=false
# Название бренда для постов и ссылка на все его товары на WB (кнопка под постом)
SHOP_NAME=
SHOP_URL=
# Ссылка на Instagram магазина — кнопка под постами в канале
INSTAGRAM_URL=

# Instagram (Meta → приложение → Instagram API с входом через Instagram). Пусто — интеграция выключена.
# Webhook в кабинете Meta: https://<DOMAIN>/instagram/webhook, поля messages и comments
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
# Telegram ID админов (узнать свой ID: @userinfobot)
ADMIN_IDS=[123456789]
# Часовой пояс для отложенных рассылок (например Europe/Moscow, Asia/Almaty)
TIMEZONE=UTC

# PostgreSQL
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=crm
DATABASE_URL=postgresql+asyncpg://crm:crm@db:5432/crm

# Claude API (AI-менеджер)
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-opus-5-5

# Доступ к CRM API (заголовок X-API-Key). Обязательно свой: openssl rand -hex 32
# С пустым значением или «change-me» приложение не запустится
ADMIN_API_KEY=

# Только для сервера: домен админки, например crm.example.com. Пусто — без HTTPS (вход через SSH-туннель)
DOMAIN=

# Веб-админка http://localhost:8000/admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Подпись cookie админки. Обязательно свой: openssl rand -hex 32
SECRET_KEY=

# Защита от накрутки и лишних расходов на AI (0 — без лимита)
# Сообщений одного клиента к AI в минуту / в сутки
AI_MESSAGES_PER_MINUTE=5
AI_MESSAGES_PER_DAY=50
# Повторный скан QR того же товара в течение стольких дней не считается новой покупкой
QR_REPEAT_DAYS=30
# Сколько разных QR один клиент может отсканировать за сутки
QR_SCANS_PER_DAY=5
